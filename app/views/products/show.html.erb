<% page_metadata title: @product.name, description: @product.short_description, image: (@product.images.attached? ? rails_blob_url(@product.images.first) : nil) %>
<article class="w-full max-w-4xl">
  <p class="text-sm text-stone-500"><%= link_to @product.category.name, category_path(@product.category), class: "underline" %></p>
  <h1 class="mt-2 text-3xl font-bold"><%= @product.name %></h1>
  <div class="mt-6 grid gap-6 md:grid-cols-2">
    <div class="space-y-3" data-controller="gallery"><% @product.images.each_with_index do |image, index| %><%= image_tag image, class: "w-full rounded object-cover #{'hidden' unless index.zero?}", alt: @product.name, data: { gallery_target: "image" } %><% end %><% if @product.images.many? %><div class="flex gap-2"><% @product.images.each_with_index do |_image, index| %><button type="button" class="rounded border px-2 py-1" data-action="gallery#show" data-gallery-index-param="<%= index %>"><%= index + 1 %></button><% end %></div><% end %></div>
    <div><p class="text-2xl font-semibold"><%= rubles(@product.price_cents) %></p><p class="mt-4 text-stone-600"><%= @product.short_description %></p><%= button_to "В корзину", cart_items_path, params: { cart_item: { product_id: @product.id } }, class: "mt-5 rounded bg-stone-900 px-4 py-2 font-medium text-white" %><div class="prose mt-6"><%= @product.description %></div></div>
  </div>
</article>
