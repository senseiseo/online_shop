<% content_for :title, "Оформление заказа" %>
<% items = @cart.cart_items.includes(:product) %>
<% total_cents = items.sum { |item| item.product.price_cents * item.quantity } %>
<section class="w-full">
  <div class="max-w-2xl"><p class="text-sm font-semibold uppercase tracking-[0.16em] text-[#71835a]">Последний шаг</p><h1 class="mt-2 text-4xl font-semibold tracking-tight sm:text-5xl">Оформление заказа</h1><p class="mt-4 leading-7 text-[#70796f]">Оставьте контакты — мы подтвердим заказ и договоримся о деталях.</p></div>

  <% if items.empty? %>
    <div class="mt-10 max-w-xl rounded-2xl border border-dashed border-[#bfc9b3] bg-white/60 px-6 py-12 text-center">
      <% if @order.errors.any? %><div class="mb-5 rounded-2xl border border-[#edc6bc] bg-[#fff0ec] p-4 text-left text-sm text-[#8f3f32]" role="alert"><ul class="list-inside list-disc"><% @order.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul></div><% end %>
      <p class="font-semibold">В корзине нет товаров.</p><%= link_to "Вернуться в каталог", catalog_path, class: "mt-5 inline-flex rounded-full bg-[#223329] px-5 py-3 text-sm font-semibold text-white" %>
    </div>
  <% else %>
    <div class="mt-10 grid gap-6 lg:grid-cols-[minmax(0,1fr)_360px] lg:items-start">
      <div class="rounded-[1.5rem] border border-[#dfe2d5] bg-white/75 p-6 sm:p-8">
        <%= form_with model: @order, url: checkout_path, class: "space-y-7" do |form| %>
          <%= form.hidden_field :cart_id, value: @cart.id %>
          <% if @order.errors.any? %>
            <div class="rounded-2xl border border-[#edc6bc] bg-[#fff0ec] p-4 text-sm text-[#8f3f32]" role="alert" aria-live="assertive">
              <p class="font-semibold">Проверьте данные заказа</p>
              <ul class="mt-2 list-inside list-disc space-y-1"><% @order.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul>
            </div>
          <% end %>

          <div>
            <h2 class="flex items-center gap-2 text-lg font-semibold"><span class="flex size-8 items-center justify-center rounded-full bg-[#dbe7ba] text-[#526548]"><%= icon(:user, size: 16) %></span> Ваши данные</h2>
            <div class="mt-5 space-y-5">
              <% name_invalid = @order.errors[:name].any? %>
              <div><%= form.label :name, "Имя", class: "text-sm font-semibold" %><%= form.text_field :name, required: true, minlength: 2, maxlength: 80, autocomplete: "name", placeholder: "Как к вам обращаться?", class: "field-control mt-2 #{'field-invalid' if name_invalid}", aria: { invalid: name_invalid, describedby: ("order_name_error" if name_invalid) } %><% @order.errors.full_messages_for(:name).each do |message| %><p id="order_name_error" class="mt-1 text-sm text-[#a64c3d]"><%= message %></p><% end %></div>
              <div class="grid gap-5 sm:grid-cols-2">
                <% phone_invalid = @order.errors[:phone].any? %>
                <div><%= form.label :phone, class: "flex items-center gap-2 text-sm font-semibold" do %><%= icon(:phone, size: 16, class_name: "size-4 text-[#71835a]") %> Телефон<% end %><%= form.telephone_field :phone, minlength: 7, maxlength: 24, inputmode: "tel", autocomplete: "tel", placeholder: "+7 (___) ___-__-__", class: "field-control mt-2 #{'field-invalid' if phone_invalid}", aria: { invalid: phone_invalid } %><p class="mt-1 text-xs text-[#8c9786]">Телефон или email — на выбор.</p><% @order.errors.full_messages_for(:phone).each do |message| %><p class="mt-1 text-sm text-[#a64c3d]"><%= message %></p><% end %></div>
                <% email_invalid = @order.errors[:email].any? %>
                <div><%= form.label :email, class: "flex items-center gap-2 text-sm font-semibold" do %><%= icon(:mail, size: 16, class_name: "size-4 text-[#71835a]") %> Email<% end %><%= form.email_field :email, maxlength: 160, autocomplete: "email", placeholder: "you@example.com", class: "field-control mt-2 #{'field-invalid' if email_invalid}", aria: { invalid: email_invalid } %><% @order.errors.full_messages_for(:email).each do |message| %><p class="mt-1 text-sm text-[#a64c3d]"><%= message %></p><% end %></div>
              </div>
              <% comment_invalid = @order.errors[:comment].any? %>
              <div><%= form.label :comment, class: "flex items-center gap-2 text-sm font-semibold" do %><%= icon(:message, size: 16, class_name: "size-4 text-[#71835a]") %> Комментарий <span class="font-normal text-[#9a9b91]">необязательно</span><% end %><%= form.text_area :comment, rows: 4, maxlength: 1_000, placeholder: "Например, удобное время для звонка", class: "field-control mt-2 resize-y #{'field-invalid' if comment_invalid}", aria: { invalid: comment_invalid } %><% @order.errors.full_messages_for(:comment).each do |message| %><p class="mt-1 text-sm text-[#a64c3d]"><%= message %></p><% end %></div>
            </div>
          </div>

          <div class="border-t border-[#dfe2d5] pt-7">
            <h2 class="flex items-center gap-2 text-lg font-semibold"><span class="flex size-8 items-center justify-center rounded-full bg-[#dbe7ba] text-[#526548]"><%= icon(:credit_card, size: 16) %></span> Способ оплаты</h2>
            <div class="mt-5 grid gap-3 sm:grid-cols-3">
              <% Order.payment_methods.keys.each do |method| %>
                <% method_icon = { "cash" => :wallet, "card_on_pickup" => :credit_card, "transfer" => :arrow_right }.fetch(method) %>
                <label class="cursor-pointer"><%= form.radio_button :payment_method, method, class: "peer sr-only" %><span class="flex h-full flex-col gap-3 rounded-2xl border border-[#dfe2d5] bg-[#fffefa] p-4 text-sm transition peer-checked:border-[#71835a] peer-checked:bg-[#edf5e5] peer-focus-visible:ring-2 peer-focus-visible:ring-[#9cac87]"><%= icon(method_icon, size: 20, class_name: "size-5 text-[#71835a]") %><span class="font-semibold"><%= t("activerecord.attributes.order.payment_methods.#{method}") %></span></span></label>
              <% end %>
            </div>
            <% @order.errors.full_messages_for(:payment_method).each do |message| %><p class="mt-2 text-sm text-[#a64c3d]"><%= message %></p><% end %>
          </div>

          <%= form.submit "Создать заказ", class: "inline-flex w-full cursor-pointer items-center justify-center gap-2 rounded-full bg-[#223329] px-5 py-3.5 font-semibold text-white transition hover:bg-[#526548]" %>
        <% end %>
      </div>

      <aside class="rounded-[1.5rem] bg-[#223329] p-6 text-white lg:sticky lg:top-28">
        <div class="flex items-center justify-between"><h2 class="text-lg font-semibold">Ваш заказ</h2><span class="rounded-full bg-white/10 px-3 py-1 text-xs text-[#cbd5c4]"><%= items.sum(&:quantity) %> шт.</span></div>
        <div class="mt-6 space-y-4 border-b border-white/15 pb-6">
          <% items.each do |item| %><div class="flex justify-between gap-4 text-sm"><span class="text-[#cbd5c4]"><%= item.product.name %> <span class="text-[#91a18f]">× <%= item.quantity %></span></span><span class="font-medium"><%= rubles(item.product.price_cents * item.quantity) %></span></div><% end %>
        </div>
        <div class="flex items-end justify-between pt-5"><span class="text-[#cbd5c4]">Итого</span><span class="text-2xl font-semibold text-[#dbe7ba]"><%= rubles(total_cents) %></span></div>
        <div class="mt-7 space-y-3 text-sm text-[#cbd5c4]"><p class="flex items-center gap-2"><%= icon(:shield, size: 17, class_name: "size-[17px] text-[#dbe7ba]") %> Данные защищены</p><p class="flex items-center gap-2"><%= icon(:truck, size: 17, class_name: "size-[17px] text-[#dbe7ba]") %> Доставка обсуждается после заказа</p></div>
      </aside>
    </div>
  <% end %>
</section>
