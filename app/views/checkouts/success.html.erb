<% content_for :title, "Заказ создан" %>
<section class="mx-auto max-w-2xl rounded-[2rem] bg-[#223329] px-6 py-14 text-center text-white shadow-[0_24px_70px_-30px_rgba(34,51,41,0.55)] sm:px-12">
  <div class="mx-auto flex size-16 items-center justify-center rounded-full bg-[#dbe7ba] text-[#223329]"><%= icon(:check, size: 30, class_name: "size-7") %></div>
  <p class="mt-7 text-sm font-semibold uppercase tracking-[0.18em] text-[#dbe7ba]">Заказ принят</p>
  <h1 class="mt-3 text-4xl font-semibold tracking-tight sm:text-5xl">Спасибо за заказ!</h1>
  <p class="mx-auto mt-5 max-w-md leading-7 text-[#cbd5c4]">Мы свяжемся с вами в ближайшее время, чтобы подтвердить детали и доставку.</p>
  <div class="mx-auto mt-8 max-w-xs rounded-2xl border border-white/15 bg-white/5 px-5 py-4"><p class="text-xs uppercase tracking-[0.16em] text-[#91a18f]">Номер заказа</p><p class="mt-2 text-xl font-semibold text-[#dbe7ba]"><%= @order.number %></p></div>
  <%= link_to root_path, class: "mt-9 inline-flex items-center gap-2 rounded-full bg-[#dbe7ba] px-5 py-3 text-sm font-semibold text-[#223329] transition hover:bg-white" do %>Вернуться в магазин <%= icon(:arrow_right, size: 17) %><% end %>
</section>
