<% content_for :title, "Статьи" %>
<section class="w-full"><h1 class="text-3xl font-bold">Статьи</h1><div class="mt-6 space-y-5">
  <% @posts.each do |post| %><article class="rounded border border-stone-200 p-5"><% if post.cover.attached? %><%= image_tag post.cover, class: "mb-4 max-h-64 w-full rounded object-cover", alt: post.title %><% end %><h2 class="text-xl font-semibold"><%= link_to post.title, post_path(post) %></h2><p class="mt-2 text-stone-600"><%= post.excerpt %></p></article><% end %>
</div><%= render "shared/pagination", pagy: @pagy %></section>
