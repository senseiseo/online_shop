<article class="group flex flex-col overflow-hidden rounded-2xl border border-[#dfe2d5] bg-white/80 transition duration-300 hover:-translate-y-1 hover:border-[#b7c29f] hover:shadow-[0_18px_45px_-28px_rgba(34,51,41,0.65)]">
  <%= link_to product_path(product), class: "block overflow-hidden" do %>
    <% if product.images.attached? %>
      <%= image_tag product.images.first, class: "aspect-square w-full object-cover transition duration-500 group-hover:scale-105", alt: product.name %>
    <% else %>
      <div class="flex aspect-square items-center justify-center bg-[#edf0e5] text-[#9cac87]" aria-hidden="true"><%= icon(:sparkle, size: 32, class_name: "size-8") %></div>
    <% end %>
  <% end %>
  <div class="flex flex-1 flex-col p-5">
    <p class="text-xs font-semibold uppercase tracking-[0.14em] text-[#8c9786]"><%= product.category.name %></p>
    <h3 class="mt-2 text-lg font-semibold tracking-tight text-[#223329]"><%= link_to product.name, product_path(product), class: "hover:text-[#526548]" %></h3>
    <div class="mt-auto flex items-center justify-between gap-3 pt-6">
      <p class="font-semibold text-[#223329]"><%= rubles(product.price_cents) %></p>
      <%= button_to cart_items_path, params: { cart_item: { product_id: product.id } }, class: "flex size-10 items-center justify-center rounded-full bg-[#223329] text-[#dbe7ba] transition hover:bg-[#526548]", aria: { label: "Добавить #{product.name} в корзину" } do %><%= icon(:bag, size: 18) %><span class="sr-only">В корзину</span><% end %>
    </div>
  </div>
</article>
