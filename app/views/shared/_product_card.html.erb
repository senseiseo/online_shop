<article class="rounded-lg border border-stone-200 bg-white p-4 shadow-sm">
  <%= link_to product_path(product), class: "block" do %>
    <% if product.images.attached? %>
      <%= image_tag product.images.first, class: "mb-4 aspect-square w-full rounded object-cover", alt: product.name %>
    <% else %>
      <div class="mb-4 aspect-square rounded bg-stone-100" aria-hidden="true"></div>
    <% end %>
    <p class="text-sm text-stone-500"><%= product.category.name %></p>
    <h3 class="text-lg font-semibold text-stone-900"><%= product.name %></h3>
    <p class="mt-2 font-medium text-stone-900"><%= rubles(product.price_cents) %></p>
  <% end %>
</article>
