<% if cart.cart_items.any? %>
  <div class="mt-6 space-y-4"><% cart.cart_items.includes(:product).each do |item| %><article class="flex flex-col gap-4 rounded border bg-white p-4 sm:flex-row sm:items-center sm:justify-between"><div class="min-w-0"><h2 class="font-semibold"><%= item.product.name %></h2><p><%= rubles(item.product.price_cents) %></p></div><div class="flex flex-wrap items-center gap-2"><%= form_with model: item, class: "flex flex-wrap items-center gap-2" do |form| %><%= form.label :quantity, "Количество", class: "sr-only" %><%= form.number_field :quantity, min: 0, class: "w-20 rounded border", data: { controller: "quantity", action: "change->quantity#submit" } %><%= form.submit "Обновить", class: "rounded border px-2 py-1" %><% end %><%= button_to "Удалить", cart_item_path(item), method: :delete, class: "text-sm underline" %></div></article><% end %></div>
  <p class="mt-6 text-xl font-semibold">Итого: <%= rubles(cart.cart_items.includes(:product).sum { |item| item.product.price_cents * item.quantity }) %></p><%= link_to "Оформить заказ", new_checkout_path, class: "mt-4 inline-block rounded bg-stone-900 px-4 py-2 text-white", data: { turbo_frame: "_top" } %>
<% else %><p class="mt-6 text-stone-600">Корзина пуста.</p><% end %>
