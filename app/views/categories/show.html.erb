<% page_metadata title: @category.name, description: @category.description %>
<section class="w-full"><h1 class="text-3xl font-bold"><%= @category.name %></h1><p class="mt-3 text-stone-600"><%= @category.description %></p>
  <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3"><%= render partial: "shared/product_card", collection: @products, as: :product %></div>
  <%= render "shared/pagination", pagy: @pagy %>
</section>
