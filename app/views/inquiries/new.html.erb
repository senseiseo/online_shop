<% content_for :title, "Связаться с нами" %>
<section class="w-full max-w-xl"><h1 class="text-3xl font-bold">Связаться с нами</h1>
  <%= form_with model: @inquiry, class: "mt-6 space-y-4" do |form| %>
    <% if @inquiry.errors.any? %><div class="rounded border border-red-300 p-3 text-red-800"><%= @inquiry.errors.full_messages.to_sentence %></div><% end %>
    <div><%= form.label :name, "Имя" %><%= form.text_field :name, required: true, class: "mt-1 block w-full rounded border-stone-300" %></div>
    <div><%= form.label :phone, "Телефон" %><%= form.telephone_field :phone, class: "mt-1 block w-full rounded border-stone-300" %></div>
    <div><%= form.label :email, "Email" %><%= form.email_field :email, class: "mt-1 block w-full rounded border-stone-300" %></div>
    <div><%= form.label :message, "Сообщение" %><%= form.text_area :message, required: true, rows: 5, class: "mt-1 block w-full rounded border-stone-300" %></div>
    <%= form.submit "Отправить", class: "rounded bg-stone-900 px-4 py-2 text-white" %>
  <% end %>
</section>
