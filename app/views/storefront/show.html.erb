<% content_for :title, "Магазин" %>

<section class="w-full space-y-12">
  <header class="rounded-xl bg-stone-900 px-6 py-16 text-white sm:px-10">
    <p class="text-sm uppercase tracking-widest text-stone-300">Свой дом</p>
    <h1 class="mt-3 text-4xl font-bold sm:text-5xl">Предметы для спокойной жизни</h1>
    <%= link_to "Смотреть каталог", catalog_path, class: "mt-6 inline-block rounded bg-white px-4 py-2 font-medium text-stone-900" %>
  </header>

  <section aria-labelledby="categories-heading">
    <div class="flex items-baseline justify-between"><h2 id="categories-heading" class="text-2xl font-bold">Категории</h2><%= link_to "Каталог", catalog_path, class: "text-sm underline" %></div>
    <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      <% @categories.each do |category| %><%= link_to category.name, category_path(category), class: "rounded border border-stone-200 p-4 font-medium hover:bg-stone-50" %><% end %>
    </div>
  </section>

  <section aria-labelledby="featured-heading">
    <h2 id="featured-heading" class="text-2xl font-bold">Избранные товары</h2>
    <div class="mt-4 grid gap-5 sm:grid-cols-2 lg:grid-cols-3"><%= render partial: "shared/product_card", collection: @products, as: :product %></div>
  </section>

  <section aria-labelledby="posts-heading">
    <div class="flex items-baseline justify-between"><h2 id="posts-heading" class="text-2xl font-bold">Статьи</h2><%= link_to "Все статьи", posts_path, class: "text-sm underline" %></div>
    <div class="mt-4 grid gap-5 md:grid-cols-3">
      <% @posts.each do |post| %><article class="rounded border border-stone-200 p-4"><h3 class="font-semibold"><%= link_to post.title, post_path(post) %></h3><p class="mt-2 text-sm text-stone-600"><%= post.excerpt %></p></article><% end %>
    </div>
  </section>
</section>
