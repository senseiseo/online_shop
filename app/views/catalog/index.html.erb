<% page_metadata title: "Каталог", description: "Каталог предметов для дома." %>
<section class="w-full">
  <h1 class="text-3xl font-bold">Каталог</h1>
  <%= form_with url: catalog_path, method: :get, class: "mt-5 flex flex-wrap gap-3", data: { turbo: false } do |form| %>
    <%= form.label :category, "Категория", class: "sr-only" %>
    <%= form.select :category, @categories.map { |category| [category.name, category.slug] }, { include_blank: "Все категории", selected: @selected_category&.slug }, class: "rounded border-stone-300" %>
    <%= form.label :sort, "Сортировка", class: "sr-only" %>
    <%= form.select :sort, [["По умолчанию", ""], ["Сначала дешевле", "price_asc"], ["Сначала дороже", "price_desc"]], { selected: params[:sort] }, class: "rounded border-stone-300" %>
    <label class="flex items-center gap-2"><%= form.check_box :featured, { checked: params[:featured] == "1" }, "1", "0" %> Избранное</label>
    <%= form.submit "Показать", class: "rounded bg-stone-900 px-4 py-2 text-white" %>
  <% end %>
  <% if @products.any? %>
    <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3"><%= render partial: "shared/product_card", collection: @products, as: :product %></div>
    <%= render "shared/pagination", pagy: @pagy %>
  <% else %>
    <p class="mt-6 text-stone-600">Товары не найдены.</p>
  <% end %>
</section>
